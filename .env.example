# Скопируйте в .env и поменяйте пароли: cp .env.example .env
POSTGRES_PASSWORD=change-me-db
ADMIN_PASSWORD=change-me-admin
# Порт, на котором откроется платформа: http://localhost:8080
TESSERA_PORT=8080
# Публичный адрес платформы — попадёт в QR-код на проекторе. Пусто: берётся адрес из браузера ведущего.
PUBLIC_URL=
# «Попробовать одному» (демо-песочница с ботами) на главной: 1 — включено, 0 — выключено.
TESSERA_PUBLIC_DEMO=1
